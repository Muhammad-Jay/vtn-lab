{
  "name": "@repo/ui",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./layouts": {
      "import": "./src/layouts.ts",
      "types": "./src/layouts.ts"
    },
    "./menus": {
      "import": "./src/menus.ts",
      "types": "./src/menus.ts"
    },
    "./views": {
      "import": "./src/views.ts",
      "types": "./src/views.ts"
    },
    "./primitives": {
      "import": "./src/primitives.ts",
      "types": "./src/primitives.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "tsup": "^8.0.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@repo/tailwind-config": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  }
}
