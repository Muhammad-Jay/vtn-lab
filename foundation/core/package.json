{
  "name": "@foundation/core",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    },
    "./hooks": {
      "import": "./src/hooks.ts",
      "types": "./src/hooks.ts"
    },
    "./services": {
      "import": "./src/services/index.ts",
      "types": "./src/services/index.ts"
    },
    "./api-client": {
      "import": "./src/api/client.ts",
      "types": "./src/api/client.ts"
    },
    "./query": {
      "import": "./src/queries/queryClient.ts",
      "types": "./src/queries/queryClient.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@foundation/domain": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/api-client": "workspace:*",
    "@repo/ui": "workspace:*",
    "lucide-react": "^1.23.0",
    "@tanstack/react-query": "^5.101.3"
  },
  "peerDependencies": {
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "tsup": "^8.0.1"
  }
}
